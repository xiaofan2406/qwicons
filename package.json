{
  "name": "qwicons",
  "version": "0.1.0",
  "description": "Latest lucide icons for Qwik app",
  "license": "MIT",
  "homepage": "https://github.com/xiaofan2406/qwicons",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaofan2406/qwicons.git"
  },
  "keywords": [
    "qwik",
    "icons",
    "lucide"
  ],
  "types": "./lib/entry.lib.d.ts",
  "qwik": "./lib/entry.lib.qwik.mjs",
  "exports": {
    ".": {
      "types": "./lib/entry.lib.d.ts",
      "import": "./lib/entry.lib.qwik.mjs",
      "require": "./lib/entry.lib.qwik.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./lib/entry.lib.d.ts"
      ]
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=15.0.0"
  },
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build.lib": "bun run build.lib.browser && bun run build.lib.types",
    "build.lib.browser": "vite build --mode lib",
    "build.lib.types": "tsc -p tsconfig.lib.json",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "generate-5-icons": "ICON_LIMIT=5 bun ./generate/generate-icons.ts",
    "generate-50-icons": "ICON_LIMIT=50 bun ./generate/generate-icons.ts",
    "generate-icons": "bun ./generate/generate-icons.ts",
    "generate-license": "bun ./generate/generate-license.ts",
    "link.lib": "bun run build.lib && bun link",
    "lint": "eslint \"src/**/*.ts*\"",
    "release": "bun run generate-icons && bun run generate-license && bun run build.lib && bunx np --yolo"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@types/eslint": "8.21.1",
    "@types/node": "^18.14.0",
    "@typescript-eslint/eslint-plugin": "5.53.0",
    "@typescript-eslint/parser": "5.53.0",
    "eslint": "8.50.0",
    "eslint-plugin-qwik": "latest",
    "fast-glob": "^3.2.12",
    "lucide-static": "^1.16.0",
    "prettier": "2.8.4",
    "svgo": "^3.0.2",
    "typescript": "4.9.5",
    "vite": "^8.0.14"
  },
  "peerDependencies": {
    "@builder.io/qwik": ">=1.0.0"
  },
  "dependencies": {}
}
